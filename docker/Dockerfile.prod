# docker/Dockerfile.prod
#
# Multi-stage: build a venv with uv (app/ installed into it as a real wheel,
# templates/static included — hatchling bundles the whole package tree) in a
# throwaway stage, then copy only /opt/venv into a minimal, non-root final
# image. Keeps the runtime image free of build tools, uv itself, and the git
# history/notebooks/scripts that ship in the repo but have no reason to be in
# a running container.

# python:3.14-slim-bookworm — same pinned digest as docker/Dockerfile.dev, kept
# in sync by Dependabot's "docker" ecosystem (.github/dependabot.yml).
FROM python:3.14-slim-bookworm@sha256:9ab8d9c8514b44f90cf0029dd42fdd7e9e211e639c8b995304cc04568dee900f AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ghcr.io/astral-sh/uv:0.12.1 — pinned to digest, matching Dockerfile.dev.
COPY --from=ghcr.io/astral-sh/uv:0.12.1@sha256:cf4eedcaa81655197f625739489effcbe71b61ceb1506f332c3facae5deceded /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# Dependencies first (cache-friendly layer) — no app code yet, so editing
# app/ doesn't invalidate this layer.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-default-groups --no-install-project --no-editable

# Now the project itself. --no-editable installs a real wheel into the venv
# rather than a .pth redirect back to /build, which won't exist in the final
# stage. README.md/LICENSE are required here too, not just app/ — hatchling
# (pyproject.toml's build backend) reads `readme`/`license-files` from
# pyproject.toml and fails the wheel build if either is missing (confirmed
# directly: dropping either produces a hatchling metadata-validation error).
COPY app ./app
COPY README.md LICENSE ./
RUN uv sync --frozen --no-default-groups --no-editable

# --- final stage -------------------------------------------------------
FROM python:3.14-slim-bookworm@sha256:9ab8d9c8514b44f90cf0029dd42fdd7e9e211e639c8b995304cc04568dee900f AS final

RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --home-dir /app --no-create-home app

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Just the venv — app/ was installed into it as a real (non-editable) wheel
# by the builder stage, so /opt/venv/lib/python*/site-packages/app is the
# code that actually runs; copying the app/ source tree again here would be
# dead weight that Python never imports (confirmed: with no source tree
# present, `import app.main` still resolves to the site-packages copy).
COPY --from=builder --chown=app:app /opt/venv /opt/venv

# data/images is gitignored (Section "Data provenance", CLAUDE.md) and never
# part of the build context — app/main.py's static mount already tolerates
# the directory being absent (check_dir=False).

USER app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\", 8000)}/healthz', timeout=3)"]

# Shell form so ${PORT}/${WEB_CONCURRENCY} expand at container start (Render
# injects PORT); `exec` replaces the shell so gunicorn is PID 1 and receives
# signals (graceful shutdown on SIGTERM) directly instead of via a shell parent.
#
# --no-control-socket: gunicorn >=25.1 creates a control socket (for the
# `gunicornc` CLI) at $HOME/.gunicorn/gunicorn.ctl by default. The `app` user's
# HOME (/app) isn't writable by it (only /opt/venv is chowned above), so this
# would otherwise log a "Control server error: Permission denied" on every
# boot -- confirmed live on Render. Non-fatal (gunicorn just runs without the
# socket) but nothing in this container ever runs `gunicornc`, so disable it
# outright instead of chowning a directory for a feature that's never used.
CMD exec gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers "${WEB_CONCURRENCY:-2}" \
    --bind "0.0.0.0:${PORT:-8000}" \
    --timeout 60 \
    --graceful-timeout 30 \
    --no-control-socket \
    --access-logfile - \
    --error-logfile -
