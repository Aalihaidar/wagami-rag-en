# docker/Dockerfile.dev

# python:3.14-slim-bookworm — pinned to digest for reproducible builds.
# Dependabot (see .github/dependabot.yml, "docker" ecosystem) will open PRs
# to bump this digest automatically; update the human-readable tag alongside it.
FROM python:3.14-slim-bookworm@sha256:9ab8d9c8514b44f90cf0029dd42fdd7e9e211e639c8b995304cc04568dee900f

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ssh \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ghcr.io/astral-sh/uv:0.12.1 — pinned to digest for reproducible builds.
COPY --from=ghcr.io/astral-sh/uv:0.12.1@sha256:cf4eedcaa81655197f625739489effcbe71b61ceb1506f332c3facae5deceded /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace

COPY scripts/entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
COPY scripts/welcome.sh /usr/local/bin/welcome.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh /usr/local/bin/welcome.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.dev.sh"]
CMD ["sleep", "infinity"]
