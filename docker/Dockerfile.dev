# docker/Dockerfile.dev

# ghcr.io/astral-sh/uv:0.12.15 — pinned to digest, matching Dockerfile.prod. Its own FROM stage
# rather than an image named inside COPY --from, so Dependabot's "docker" ecosystem, which reads
# FROM lines, keeps it current. The last stage below is the one the dev container runs.
FROM ghcr.io/astral-sh/uv:0.12.15@sha256:62f8c047d0a0e9ece6b53fc63df902585a67a47a7f318ddec4a37db586edc8e3 AS uv

# python:3.14-slim-bookworm — pinned to digest for reproducible builds.
# Dependabot (see .github/dependabot.yml, "docker" ecosystem) will open PRs
# to bump this digest automatically; update the human-readable tag alongside it.
FROM python:3.14-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ssh \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace

COPY scripts/entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
COPY scripts/welcome.sh /usr/local/bin/welcome.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh /usr/local/bin/welcome.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.dev.sh"]
CMD ["sleep", "infinity"]
