# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- App ---
APP_ENV=development           # development | production
PORT=8000
LOG_LEVEL=info

# --- Weaviate Cloud (same in dev and prod, per architecture decision) ---
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=            # Admin-role key -- scripts/ create/drop the collection and write objects
# Viewer-role key for the future app/ retrieval path (read-only). Unused in
# phase 1; the load/delete scripts always use WEAVIATE_API_KEY above.
WEAVIATE_READ_API_KEY=

# --- Embeddings (online API, via Weaviate's vectorizer module) ---
# embed-english-v3.0 -- Cohere's English-specialized embedding model; this
# corpus is English-only.
EMBEDDING_PROVIDER=cohere     # cohere | openai
EMBEDDING_API_KEY=            # Cohere or OpenAI key, matching EMBEDDING_PROVIDER

# --- Menu images (public object storage / CDN origin) ---
# Base URL that a knowledge_base row's `image` filename is appended to.
# Leave empty to disable image links in responses.
# e.g. https://pub-<hash>.r2.dev/menu  (Cloudflare R2 public dev URL)
#  or  https://cdn.yourdomain.com/menu (R2 custom domain)
IMAGE_BASE_URL=

# --- LLM (API-based, same in dev and prod) ---
LLM_PROVIDER=google        # google | openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# --- Groq (OpenAI-compatible endpoint, used by notebooks/02_generation_checks_groq.ipynb
# and notebooks/03_evaluation.ipynb) ---
GROQ_API_KEY=

# --- Groq key pool (rotation across per-key rate/quota limits, e.g. for running
# 03_evaluation.ipynb repeatedly without waiting out a single key's daily quota).
# Each GROQ_API_KEY_N is a separate Groq account's key -- unused for now. ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
GROQ_API_KEY_11=

# --- Gemini key pool (same idea, for LLM_PROVIDER=google -- unused for now) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=

# --- Redis (optional — only needed if LangGraph checkpointing/session memory is added) ---
REDIS_URL=redis://redis:6379/0

# --- CI / deployment (set as GitHub Actions secrets, not here) ---
# Not wired up yet -- this project is still phase 1 (data + Weaviate only).
