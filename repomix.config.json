{
  "output": {
    "filePath": "wagami-rag-en-code.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "parsableStyle": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100
    },
    "headerText": "wagami-rag-en — Python RAG chatbot backend (English only), phase 1: knowledge base + Weaviate ingestion, running in a Docker dev container.\nGenerated by Repomix for AI-assisted code review and analysis."
  },
  "include": [
    ".devcontainer/**",
    "data/**",
    "docker/**",
    "scripts/**",
    "README.md",
    "pyproject.toml",
    "docker-compose.yml",
    ".env.example",
    ".gitignore",
    ".pre-commit-config.yaml",
    "repomix.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "uv.lock",
      "**/devcontainer-lock.json",
      "**/.ipynb_checkpoints/**",
      "data/**/*.sqlite3",
      "data/**/*.faiss",
      "data/**/*.parquet",
      "*.pdf",
      "*.png",
      "*.jpg",
      "*.jpeg"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
