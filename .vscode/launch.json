{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "KB: load (create schema + import)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_knowledge_base.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "KB: delete + recreate schema  (writes to live Weaviate)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/delete_knowledge_base.py",
      "args": ["--keep-schema"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Python: debug pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      // Attach to a process started with:
      //   python -m debugpy --listen 0.0.0.0:5678 --wait-for-client <script>
      // Port 5678 is forwarded by docker-compose / devcontainer.
      "name": "Python: attach to debugpy (:5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}", "remoteRoot": "/workspace" }
      ],
      "justMyCode": false
    }
  ]
}
